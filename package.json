{
    "name": "emu-react",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bunx react-router build",
        "dev": "bunx react-router dev --host",
        "start": "bunx react-router-serve ./build/server/index.js",
        "typecheck": "bunx react-router typegen && bunx tsc --incremental --tsBuildInfoFile .cache/tsc.tsbuildinfo",
        "format": "bunx prettier . --write",
        "format:check": "bunx prettier . --check --cache --cache-location .cache/prettier",
        "check": "bun run format:check && bun run typecheck && bun run test && bun run lint",
        "lint": "bunx eslint .",
        "test": "bunx vitest run",
        "health": "bun run format && bun run check",
        "prepare": "bunx husky"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.3.0",
        "@mui/icons-material": "^9.3.1",
        "@mui/material": "^9.3.1",
        "@react-router/node": "^8.3.0",
        "@react-router/serve": "^8.3.0",
        "basic-ftp": "^6.2.0",
        "isbot": "^5.2.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0",
        "redis": "^6.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@react-router/dev": "^8.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "eslint": "^10.8.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.1",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.10"
    }
}
