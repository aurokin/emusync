# Copy to .env for local development. In production these are set as
# Environment= lines in the systemd unit (see deploy/emusync.service), not
# from a file.

# Where the device and server configuration lives. Defaults to ./db.json,
# which is gitignored — there is no committed example because it holds the
# real paths of every device in the fleet.
DB_PATH=./db.json

# Job state and sync logs. Required, but connected lazily: the process will
# start without Redis and fail the requests instead.
REDIS_URL=redis://localhost:6379

# Port for `bun run start`. The dev server (`bun run dev`) uses 5173.
PORT=3000
